<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/rowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/textPrimary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/rowRisk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/warning" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/rowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingTop="3dp" android:textColor="@color/textSecondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="5dp">
        <TextView android:id="@+id/rowRadio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/info" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/rowRssi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="12dp" android:textColor="@color/textSecondary" android:textSize="11sp" />
        <TextView android:id="@+id/rowSeen" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:textColor="@color/textSecondary" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
